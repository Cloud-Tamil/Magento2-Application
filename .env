# ============================================================
# Magento
# ============================================================

MAGENTO_VERSION=2.4.8-p5

MAGENTO_BASE_URL=http://localhost:8080/

MAGENTO_ADMIN_FIRSTNAME=Admin
MAGENTO_ADMIN_LASTNAME=User
MAGENTO_ADMIN_EMAIL=admin@example.com
MAGENTO_ADMIN_USER=admin
MAGENTO_ADMIN_PASSWORD=Admin123!ChangeMe

MAGENTO_ADMIN_URI=admin

MAGENTO_LANGUAGE=en_US
MAGENTO_CURRENCY=USD
MAGENTO_TIMEZONE=Asia/Kolkata


# ============================================================
# Database
# ============================================================

MYSQL_DATABASE=magento
MYSQL_USER=magento
MYSQL_PASSWORD=magento_password
MYSQL_ROOT_PASSWORD=root_password_change_me


# ============================================================
# OpenSearch
# ============================================================

OPENSEARCH_VERSION=3

OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m


# ============================================================
# Valkey
# ============================================================

VALKEY_VERSION=8.1


# ============================================================
# Ports
# ============================================================

NGINX_PORT=8080
OPENSEARCH_PORT=9200
MYSQL_PORT=3306
VALKEY_PORT=6379


# ============================================================
# Composer
# ============================================================

# IMPORTANT:
# Do NOT put real credentials in this file.
#
# Export COMPOSER_AUTH before building.
